# Application
APP_NAME="Running Route AI"
ENVIRONMENT=development
DEBUG=true

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
# Optional: override the API base URL to use an OpenAI-compatible provider.
# For Google Gemini, use its OpenAI-compatible endpoint and a Gemini API key:
#   OPENAI_MODEL=gemini-2.5-flash
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_BASE_URL=https://api.openai.com/v1

# Supabase
SUPABASE_URL=https://your-project.supabase.co
# anon (public) key — used for auth / token validation
SUPABASE_KEY=your-anon-key
# service_role (secret) key — backend DATA access, bypasses RLS. KEEP SECRET,
# server-side only (Dashboard > Project Settings > API > service_role).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Map APIs (South Korea)
# Kakao Maps REST API key (https://developers.kakao.com)
KAKAO_REST_API_KEY=your-kakao-rest-api-key

# Naver Maps (NCP) credentials (https://www.ncloud.com)
NAVER_MAP_CLIENT_ID=your-naver-client-id
NAVER_MAP_CLIENT_SECRET=your-naver-client-secret

# T-map (SK Telecom) app key — sidewalk-accurate pedestrian routing
# (https://tmapapi.sktelecom.com)
TMAP_APP_KEY=your-tmap-app-key

# Which provider to use for pedestrian routing: "kakao", "naver", or "tmap"
# Use "tmap" for true sidewalk-level walking routes for runners.
MAP_PROVIDER=kakao

# OpenWeather (current weather + air pollution proxy)
OPENWEATHER_API_KEY=your-openweather-api-key
